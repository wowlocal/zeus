#!/usr/bin/env bash
# Run Python in this checkout's environment: `scripts/zeus-python ARGS...`.
#
# A GitHub Actions job runs the interpreter setup-pm exported as ZEUS_PYTHON,
# so a recipe never re-runs setup on a runner. Anywhere else ZEUS_PYTHON may
# be inherited from a wrapped `zeus` (a release venv without the dev tools),
# so scripts/run-in-zeus-env applies (and if stale, syncs) the environment
# `source ./activate` gives a shell.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" = true ] && [ -z "${__ZEUS_ACTIVATED:-}" ] && [ -n "${ZEUS_PYTHON:-}" ] \
    && [ -x "$ZEUS_PYTHON" ]; then
    exec "$ZEUS_PYTHON" "$@"
fi
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-in-zeus-env" python "$@"
